# ── MicroClimate Monitor Environment Variables ──
# Copy this file to .env and adjust values as needed.

# Server port (default 3000)
PORT=3000

# JWT secret key – change this to a random string in production!
JWT_SECRET=microclimate_secret_change_me_in_production

# JWT token expiry (e.g., 7d, 24h, 1h)
JWT_EXPIRY=7d

# Serial baud rate (must match Arduino sketch)
BAUD_RATE=9600

# Default COM port (leave blank for auto-detect)
# Examples: COM3 (Windows), /dev/ttyACM0 (Linux), /dev/cu.usbmodem14101 (macOS)
SERIAL_PORT=

# Start in demo/simulation mode if true (no Arduino needed)
DEMO_MODE=true

# SQLite database file path
DB_PATH=./data/microclimate.db
